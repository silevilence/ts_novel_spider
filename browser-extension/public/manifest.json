{
  "manifest_version": 3,
  "name": "TS Novel Spider Browser Bridge",
  "description": "User-authorized browser transport for TS Novel Spider.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "downloads", "cookies", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TS Novel Spider",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}

{
  "manifest_version": 3,
  "name": "TS Novel Spider Browser Bridge",
  "description": "User-authorized browser transport for TS Novel Spider.",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TS Novel Spider",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}

{
  "name": "ts-novel-spider",
  "version": "0.10.0",
  "private": true,
  "description": "TypeScript novel spider with Express backend and React control panel.",
  "scripts": {
    "dev": "concurrently -k \"node scripts/dev/diagnostic-command.mjs dev:server\" \"node scripts/dev/diagnostic-command.mjs dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config src/web/vite.config.ts",
    "test": "npm run test:server && npm run test:web && npm run test:ci",
    "test:ci": "node --test scripts/ci/prepare-release.test.mjs",
    "test:server:library": "tsx --test src/server/routes/library.test.ts",
    "test:server:library:graph": "tsx --test src/server/routes/library-graph.test.ts",
    "test:server": "tsx --test src/server/**/*.test.ts",
    "test:web": "tsx --test src/web/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@ai-sdk/google": "^3.0.71",
    "@ai-sdk/openai": "^3.0.63",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@langchain/core": "^1.1.46",
    "@langchain/langgraph": "^1.3.0",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@tabler/icons-react": "^3.44.0",
    "@xyflow/react": "^12.11.2",
    "ai": "^6.0.177",
    "ai-sdk-ollama": "^3.8.3",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.5.0",
    "express": "^5.1.0",
    "jsonrepair": "^3.14.0",
    "jszip": "^3.10.1",
    "neo4j-driver": "^5.28.1",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
